VIO_API_KEY=vio_sk_xxx
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5433/freetokenai_dev
REDIS_URL=redis://localhost:6380

# --- Wajib di production ---
# Signing key JWT admin (Bearer). Kosong -> dev fallback, produksi menolak start request.
ADMIN_JWT_SECRET=
# Pepper hash password admin (scrypt). Kosong -> dev fallback, produksi menolak.
ADMIN_PASSWORD_PEPPER=
# Kunci enkripsi AES-256-GCM untuk API key provider di DB (menu /admin/models).
# Bangkitkan dengan: npm run gen:key  (64 karakter hex)
APP_ENCRYPTION_KEY=

# --- Opsional ---
# Umur token admin (detik). Default 900 / 604800.
ADMIN_ACCESS_TTL=900
ADMIN_REFRESH_TTL=604800
# Origin tambahan untuk CORS admin, dipisah koma.
ADMIN_ALLOWED_ORIGINS=
# Base URL publik untuk link klaim & QR struk (mis. https://app.example.com).
# Kosong -> ikut origin request / header x-forwarded-host. Nama lama: CLAIM_BASE_URL.
APP_BASE_URL=
